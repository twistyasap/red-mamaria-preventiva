# Copia este archivo como ".env" y completa los valores.
# El archivo .env NO se sube a git (está en .gitignore).

# Obtén tu key en https://aistudio.google.com/apikey
GEMINI_API_KEY=pega_tu_key_aqui

# Opcional: modelos a probar en orden, separados por coma.
# Revisa cuáles tienes disponibles con: python manage.py modelos_gemini
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
